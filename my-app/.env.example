# Wallet Configuration
# Set a strong passphrase for wallet access
WALLET_PASSPHRASE="your-strong-passphrase-here"

# Session secret for JWT tokens (generate a random string for production)
WALLET_SESSION_SECRET="your-session-secret-here-change-in-production"

# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (Supabase Postgres — used by Prisma for wallet schema + storage setup)
# Use the connection pooler URL for DATABASE_URL and the direct connection for DIRECT_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Upstash Redis (optional — visitor analytics uses an in-memory store when unset)
# KV_REST_API_URL="https://your-redis-url.upstash.io"
# KV_REST_API_TOKEN="your-redis-token"
